{
    "name": "quickwrite/kittyshare",
    "description": "A very simple file-sharing application for your server.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "KittyShare\\": "src/"
        }
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "lint": "find src public bin -type f \\( -name '*.php' -o -path '*/bin/*' \\) -exec php -l {} \\;",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "migrate": "php bin/migrate",
        "ci": [
            "@lint",
            "@analyse"
        ],
        "test": "echo 'No test suite yet.' && exit 1",
        "start": "php -S localhost:8000 -t public"
    }
}
