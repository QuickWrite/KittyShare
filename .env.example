# The application reads the environment only; This file is for easy configuration only.

# Path to the SQLite database file.
KITTYSHARE_DATABASE_PATH=/database.sqlite

# Root directory the admin file picker may browse and share from.
KITTYSHARE_ROOT=/data/files

# Session lifetime in seconds (default: 2592000 = 30 days).
KITTYSHARE_SESSION_LIFETIME=2592000

# Session cookie SameSite policy: Lax, Strict or None (default: Lax).
# None requires Secure.
KITTYSHARE_COOKIE_SAMESITE=Lax

# Session cookie Secure flag: 1/true/yes/on or 0/false/no/off.
# When unset, it follows whether the request uses HTTPS.
KITTYSHARE_COOKIE_SECURE=false

# List dotfiles in share and picker listings: true to show (default: hidden).
KITTYSHARE_SHOW_DOTFILES=false

# Canonical base URL used for absolute share links (default: relative links).
KITTYSHARE_BASE_URL=https://files.example.com

# Number of bytes sent per chunk when downloading files (default: 8192).
KITTYSHARE_DOWNLOAD_CHUNK_SIZE=8192
